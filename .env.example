# Legacy unused (Kie.ai removed)
# UPSTREAM_API_KEY=
# UPSTREAM_BASE_URL=

# A6 (a6api.com) — sole OpenAI-compatible upstream for catalog chat models
# Primary: cheap pool (e.g. custom 3–50% low-price). Fallback: wider/stable key.
A6_API_KEY=
A6_API_KEY_FALLBACK=
# Per model (ALL chat via chat_a6 — research/panel/judge/new models):
#   30% → walk N live suppliers; fail → 70% for cooldown; then retry 30% with NEW suppliers.
# Dead suppliers remembered per model+key lane (primary/fallback) for TTL below.
A6_PRIMARY_COOLDOWN_S=900
# A6_DEAD_SUPPLIER_TTL_S=7200
# A6_TOP_SUPPLIERS=3
# A6_FALLBACK_TOP_SUPPLIERS=3
# A6_GROUP_ATTEMPTS=1
A6_BASE_URL=https://a6api.com/v1
A6_ENABLED=true

# Research×3 → Sonnet 4.6 glue (non-light / zeus.research)
FUSION_RESEARCH_CREW_ENABLED=true
FUSION_RESEARCH_CREW_ALWAYS=false
# Web pack free-first: DDG → Google/Yandex → rare browser. Optional Tavily key.
WEB_RESEARCH_ENABLED=true
# TAVILY_API_KEY=
WEB_RESEARCH_MAX_RESULTS=4
WEB_RESEARCH_MAX_FETCH=4
WEB_SEARCH_CACHE_TTL_S=900
WEB_SEARCH_CONCURRENCY=4
WEB_BROWSER_GLOBAL_SLOTS=2
WEB_SERP_TIMEOUT_S=12

# Live UI verify (browser-daemon + vision). Start daemon:
#   python backend/scripts/run_browser_daemon.py
#   WEB_BROWSER_SOCK=/tmp/browser-daemon/daemon.sock
# Browser is optional for research scale — prefer DDG+httpx; daemon = rare escalate.
FUSION_UI_LIVE_VERIFY=true
WEB_BROWSER_ENABLED=true
WEB_BROWSER_SOCK=/tmp/browser-daemon/daemon.sock
JARVIS_BROWSER_CLI=

# Optional: second upstream for DeepSeek / Kimi
# DEEPINFRA_API_KEY=
# IKUNCODE_API_KEY=

# GitHub OAuth (Studio) — or use PAT via UI
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/github/callback
APP_PUBLIC_URL=http://127.0.0.1:8080
# Optional: Fernet key material (defaults to JWT_SECRET hash)
TOKEN_ENCRYPT_KEY=
# Comma-separated models for Fork ×3
FORK_MODELS=gemini-2.5-flash,gemini-2.5-flash,gemini-2.5-flash

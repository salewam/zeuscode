lur(10px);\n            z-index: 100;\n            display: flex;\n            align-items: center;\n            border-bottom: 1px solid var(--color-asphalt-light);\n            transition: transform 0.3s ease;\n        }\n\n        .container {\n            width: 100%;\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        .header-inner {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            width: 100%;\n        }\n\n        .logo {\n            font-family: var(--font-headings);\n            font-size: 28px;\n            color: var(--color-amber);\n            letter-spacing: 1px;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 30px;\n        }\n\n        .nav-links a {\n            font-size: 14px;\n            font-weight: 600;\n            text-transform: uppercase;\n            transition: color 0.3s;\n        }\n        .nav-links a:hover { color: var(--color-amber); }\n\n        .header-phone {\n            font-weight: 600;\n            font-size: 18px;\n            transition: color 0.3s;\n        }\n        .header-phone:hover {\n            color: var(--color-amber);\n        }\n\n        .hamburger {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--color-text-light);\n            font-size: 28px;\n            cursor: pointer;\n            z-index: 101;\n        }\n\n        /* --- Hero Section --- */\n        .hero {\n            height: 100vh;\n            min-height: 600px;\n            padding-top: var(--header-height);\n            background: linear-gradient(rgba(30,30,30,0.7), rgba(30,30,30,0.9)),\n                        url('https://images.unsplash.com/photo-1625047509168-a7026f36de04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;\n            display: flex;\n            align-items: center;\n            position: relative;\n        }\n\n        .hero-content {\n            max-width: 800px;\n            animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .hero h1 {\n            font-size: clamp(2.5rem, 6vw, 6rem);\n            line-height: 1.1;\n            color: var(--color-amber);\n            margin-bottom: 20px;\n            text-shadow: 2px 2px 10px rgba(0,0,0,0.5);\n        }\n\n        .hero p {\n            font-size: clamp(1rem, 2vw, 1.25rem);\n            margin-bottom: 40px;\n            max-width: 600px;\n        }\n\n        .btn {\n            display: inline-block;\n            background-color: var(--color-amber);\n            color: #fff;\n            padding: 16px 36px;\n            font-family: var(--font-headings);\n            font-size: 18px;\n            text-transform: uppercase;\n            border: none;\n            cursor: pointer;\n            text-align: center;\n            transition: background-color 0.3s, transform 0.2s;\n        }\n\n        .btn:hover {\n            background-color: var(--color-amber-hover);\n            transform: translateY(-2px);\n        }\n        \n        .btn-full {\n            width: 100%;\n        }\n\n        /* --- Services --- */\n        .section {\n            padding: 100px 0;\n        }\n        \n        .section-bg {\n            background-color: var(--color-asphalt);\n        }\n\n        .section-title {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: 60px;\n            text-align: center;\n            color: var(--color-text-light);\n        }\n        .section-title span { color: var(--color-amber); }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: 30px;\n        }\n\n        .service-card {\n            background-color: var(--color-bg);\n            padding:
      align-items: center;\n        }\n        .faq-question::after {\n            content: '+';\n            font-size: 24px;\n            color: var(--color-amber);\n            transition: transform 0.3s;\n        }\n        .faq-item.active .faq-question::after { transform: rotate(45deg); }\n        \n        .faq-answer {\n            max-height: 0;\n            overflow: hidden;\n            transition: max-height 0.3s ease-out;\n            padding: 0 20px;\n            color: var(--color-text-muted);\n        }\n        .faq-item.active .faq-answer {\n            max-height: 300px;\n            padding-bottom: 20px;\n        }\n\n        /* --- Contact & Booking --- */\n        .contact-section {\n            background: linear-gradient(rgba(44,45,49,0.9), rgba(44,45,49,0.9)), url('https://images.unsplash.com/photo-1599256621730-535171e28e50?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;\n        }\n        .contact-wrap {\n            display: grid;\n            grid-template-columns: 1fr 1.2fr;\n            gap: 50px;\n            align-items: center;\n        }\n        .contact-info h3 { font-size: 30px; margin-bottom: 30px; color: var(--color-amber); }\n        .info-line { margin-bottom: 20px; font-size: 18px; }\n        .info-line span { color: var(--color-text-muted); display: block; font-size: 14px; text-transform: uppercase; margin-bottom: 5px; }\n\n        .booking-form-wrap {\n            background-color: var(--color-bg);\n            padding: 40px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n        }\n        \n        .form-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 20px;\n            margin-bottom: 20px;\n        }\n        \n        .form-group { display: flex; flex-direction: column; }\n        .form-group.full { grid-column: 1 / -1; }\n        \n        .form-group label {\n            font-size: 14px;\n            color: var(--color-text-muted);\n            margin-bottom: 8px;\n        }\n        \n        .form-group input, .form-group select {\n            width: 100%;\n            background-color: var(--color-asphalt-light);\n            border: 1px solid transparent;\n            color: #fff;\n            padding: 16px;\n            font-family: var(--font-body);\n            font-size: 16px; /* iOS zoom fix */\n            outline: none;\n            transition: border-color 0.3s;\n        }\n        .form-group input:focus, .form-group select:focus {\n            border-color: var(--color-amber);\n        }\n\n        .form-success {\n            display: none;\n            background-color: rgba(217, 119, 6, 0.1);\n            border: 1px solid var(--color-amber);\n            padding: 30px 20px;\n            text-align: center;\n        }\n        .form-success h4 {\n            color: var(--color-amber);\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n\n        /* --- Footer --- */\n        footer {\n            background-color: #111;\n            padding: 30px 0;\n            text-align: center;\n            font-size: 14px;\n            color: var(--color-text-muted);\n        }\n\n        /* --- Animations --- */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(30px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .observe-animate {\n            opacity: 0;\n            transform: translateY(20px);\n            transition: opacity 0.6s ease-out, transform 0.6s ease-out;\n        }\n        .observe-animate.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* --- Mobile CTA --- */\n        .mobile-cta {\n            display: none;\n            position: fixed;\n            bottom: 0; left: 0; width: 100%;\n            background-color: var(--color-amber);\n            color: #fff;\n            text-align: center;\n            padding: 18px;\n            font-family: var(--font-headings);\n            font-size: 18px;\n            text-transform: uppercase;\n            z-index: 90;\n            font-weight: 700;\n            box-shadow: 0 -4px 10px rgba(0,0,0,0.3);\n            transition: transform 0.3s ease;\n        }\n        .mobile-cta.hidden {\n            transform: translateY(100%);\n        }\n\n        /* --- Responsive --- */\n        @media (max-width: 992px) {\n            .paint-shop, .reviews-faq-wrap, .contact-wrap {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                position: fixed;\n                top: var(--header-height);\n                left: -100%;\n                width: 100%;\n                height: calc(100vh - var(--header-height));\n                background-color: var(--color-asphalt);\n                flex-direction: column;\n                align-items: center;\n                justify-content: flex-start;\n                padding-top: 40px;\n                transition: left 0.3s ease;\n                z-index: 99;\n            }\n            .nav-links.active { left: 0; }\n            .nav-links a {\n                font-size: 20px;\n                margin-bottom: 25px;\n            }\n            .hamburger { display: block; }\n            .header-phone { display: none; }\n            \n            .services-grid { grid-template-columns: 1fr; }\n            .form-grid { grid-template-columns: 1fr; }\n            .mobile-cta { display: block; }\n            \n            footer { padding-bottom: 80px; }\n        }\n\n        @media (max-width: 480px) {\n            .section { padding: 60px 0; }\n            .section-title { font-size: 2rem; margin-bottom: 40px; }\n            .paint-images { grid-template-columns: 1fr; }\n            .booking-form-wrap { padding: 25px 20px; }\n            .review-card { padding: 20px; }\n        }\n    </style>\n</head>\n<body>\n\n    <header id=\"header\">\n        <div class=\"container\">\n            <div class=\"header-inner\">\n                <div class=\"logo\">МОТОРХАУС</div>\n                <nav class=\"nav-links\" id=\"navLinks\">\n                    <a href=\"#services\" class=\"nav-item\">Услуги</a>\n                    <a href=\"#paint\" class=\"nav-item\">Малярный цех</a>\n                    <a href=\"#about\" class=\"nav-item\">Почему мы</a>\n                    <a href=\"#reviews\" class=\"nav-item\">Отзывы / FAQ</a>\n                </nav>\n                <a href=\"tel:+74951234567\" class=\"header-phone\">+7 (495) 123-45-67</a>\n                <button class=\"hamburger\" id=\"hamburger\" aria-label=\"Меню\">☰</button>\n            </div>\n        </div>\n    </header>\n\n    <section class=\"hero\">\n        <div class=\"container\">\n            <div class=\"hero-content\">\n                <h1>МОТОРХАУС</h1>\n                <p>Полный комплекс обслуживания и профессиональный малярный цех на Каширском шоссе. Восстанавливаем геометрию, цвет и уверенность на дороге.</p>\n                <a href=\"#booking\" class=\"btn\">Записаться в сервис</a>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"services\" class=\"section section-bg\">\n        <div class=\"container\">\n            <h2 class=\"section-title\">Наши <span>Услуги</span></h2>\n            <div class=\"services-grid\">\n                <div class=\"service-card observe-animate\">\n                    <h3>Слесарные работы / ТО</h3>\n                    <p>Плановое техническое обслуживание, замена масел, фильтров, колодок. Ремонт ходовой части и двигателей с гарантией на работы.</p>\n                </div>\n                <div class=\"service-card observe-animate\">\n                    <h3>Компьютерная диагностика</h3>\n                    <p>Чтение и сброс ошибок, адаптация блоков, проверка работы датчиков и электронных систем дилерским оборудованием.</p>\n                </div>\n                <div class=\"service-card observe-animate\">\n                    <h3>Малярные работы и покраска</h3>\n                    <p>Полная и подетальная покраска в итальянской камере. Точный подбор цвета, соблюдение технологических слоев, премиальные лаки.</p>\n                </div>\n                <div class=\"service-card observe-animate\">\n                    <h3>Локальный кузовной ремонт</h3>\n                    <p>Удаление вмятин, восстановление пластика бамперов, сварка трещин. Максимальное сохранение заводского ЛКП там, где это возможно.</p>\n                </div>\n                <div class=\"service-card observe-animate\">\n                    <h3>Полировка и детейлинг</h3>\n                    <p>Абразивная и восстановительная полировка кузова. Нанесение керамики, жидкого стекла, химчистка салона, антикоррозийная обработка дна.</p>\n                </div>\n                <div class=\"service-card observe-animate\">\n                    <h3>Шиномонтаж и балансировка</h3>\n                    <p>Сезонная переобувка, правка дисков, ремонт проколов и боковых порезов. Точная 3D-балансировка колес.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"paint\" class=\"section\">\n        <div class=\"container paint-shop\">\n            <div class=\"paint-content observe-animate\">\n                <h2>Малярный <span>Цех</span></h2>\n                <p style=\"margin-bottom: 20px; color: var(--color-text-muted);\">\n                    Наш флагманский отдел. Мы не красим «в гараже». Все работы проводятся в профессиональной покрасочно-сушильной камере с приточно-вытяжной вентиляцией.\n                </p>\n                <ul class=\"paint-features\">\n                    <li>Итальянская камера USI Italia (полное отсутствие пыли)</li>\n                    <li>Материалы премиум-сегмента: Sikkens, Glasurit</li>\n                    <li>Точный спектрофотометрический подбор автоэмали</li>\n                    <li>Официальная гарантия на ЛКП — 12 месяцев</li>\n                </ul>\n                <a href=\"#booking\" class=\"btn\">Оценить стоимость</a>\n            </div>\n            <div class=\"paint-images observe-animate\">\n                <div class=\"paint-img\" data-label=\"До\" style=\"background-image: url('https://images.unsplash.com/photo-1605814526279-dff00072cb0b?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80'); filter: grayscale(80%);\"></div>\n                <div class=\"paint-img\" data-label=\"После\" style=\"background-image: url('https://images.unsplash.com/photo-1605814526279-dff00072cb0b?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80');\"></div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"about\" class=\"section section-bg\">\n        <div class=\"container\">\n            <h2 class=\"section-title\">Почему выбирают <span>Нас</span></h2>\n            <div class=\"features-grid\">\n                <div class=\"observe-animate\">\n                    <div class=\"feature-icon\">📝</div>\n                    <h3 class=\"feature-title\">Честная смета</h3>\n                    <p class=\"color-text-muted\">Цена не меняется в процессе ремонта. Все скрытые дефекты согласовываем заранее.</p>\n                </div>\n                <div class=\"observe-animate\">\n                    <div class=\"feature-icon\">🛡️</div>\n                    <h3 class=\"feature-title\">Гарантия качества</h3>\n                    <p class=\"color-text-muted\">Даем документальную гарантию на слесарные и малярные работы.</p>\n                    <span class=\"stats-highlight\">12 месяцев гарантии</span>\n                </div>\n                <div class=\"observe-animate\">\n                    <div class=\"feature-icon\">🏅</div>\n                    <h3 class=\"feature-title\">Опыт и результат</h3>\n                    <p class=\"color-text-muted\">Работаем на результат, соблюдая строгие стандарты качества.</p>\n                    <span class=\"stats-highlight\">1500+ окрашенных авто</span>\n                </div>\n                <div class=\"observe-animate\">\n                    <div class=\"feature-icon\">☕</div>\n                    <h3 class=\"feature-title\">Зона ожидания</h3>\n                    <p class=\"color-text-muted\">Комфортный зал с кофе, Wi-Fi и мониторами для наблюдения за ремзоной.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"reviews\" class=\"section\">\n        <div class=\"container reviews-faq-wrap\">\n            <div class=\"observe-animate\">\n                <h2 style=\"font-size: 2rem; margin-bottom: 30px; font-family: var(--font-headings); text-transform: uppercase;\">Отзывы <span>клиентов</span></h2>\n                <div class=\"review-card\">\n                    <div class=\"review-author\">Алексей С. (BMW X5)</div>\n                    <p>«Красил капот и бампер от сколов. В цвет попали идеально, шагрень заводская. Машину отдали чистой, точно в срок. Отличный сервис.»</p>\n                </div>\n                <div class=\"review-card\">\n                    <div class=\"review-author\">Мария В. (Mazda 3)</div>\n                    <p>«Приехала на плановое ТО и замену колодок. Ребята все показали, лишнего не навязывали. Очень уютная зона ожидания с кофе!»</p>\n                </div>\n                <div class=\"review-card\">\n                    <div class=\"review-author\">Игорь Д. (Toyota Camry)</div>\n                    <p>«Делал полировку и покрывал керамикой. Машина блестит как из салона. Цены адекватные, мастера знают свое дело.»</p>\n                </div>\n            </div>\n\n            <div class=\"observe-animate\">\n                <h2 style=\"font-size: 2rem; margin-bottom: 30px; font-family: var(--font-headings); text-transform: uppercase;\">Популярные <span>Вопросы</span></h2>\n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">Вы даете гарантию на покраску?</div>\n                    <div class=\"faq-answer\">\n                        <p>Да, мы предоставляем официальную гарантию 1 год на все малярные работы и ЛКП при соблюдении рекомендаций по уходу.</p>\n                    </div>\n                </div>\n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">Можно ли присутствовать при ремонте?</div>\n                    <div class=\"faq-answer\">\n                        <p>Вы можете находиться в зоне ожидания, где установлены мониторы с трансляцией из ремзоны. Проход в саму ремонтную зону возможен только в сопровождении мастера.</p>\n                    </div>\n                </div>\n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">Сколько времени занимает локальный ремонт?</div>\n                    <div class=\"faq-answer\">\n                        <p>В зависимости от сложности повреждения локальный ремонт и покраска одного элемента обычно занимает от 1 до 3 дней.</p>\n                    </div>\n                </div>\n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">Какие запчасти вы используете?</div>\n                    <div class=\"faq-answer\">\n                        <p>Мы предлагаем как оригинальные запчасти, так и качественные сертифицированные аналоги. Выбор всегда согласовывается с клиентом до начала работ.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"booking\" class=\"section contact-section\">\n        <div class=\"container contact-wrap\">\n            <div class=\"contact-info observe-animate\">\n                <h3>Ждем вас в МоторХаус</h3>\n                <div class=\"info-line\">\n                    <span>Адрес:</span>\n                    г. Москва, Каширское шоссе, д. 45\n                </div>\n                <div class=\"info-line\">\n                    <span>Режим работы:</span>\n                    Ежедневно с 9:00 до 21:00\n                </div>\n                <div class=\"info-line\">\n                    <span>Телефон:</span>\n                    <a href=\"tel:+74951234567\">+7 (495) 123-45-67</a>\n                </div>\n            </div>\n\n            <div class=\"booking-form-wrap observe-animate\">\n                <form id=\"bookingForm\" class=\"booking-form\">\n                    <h3 style=\"font-family: var(--font-headings); font-size: 24px; margin-bottom: 20px; text-transform: uppercase;\">Запись на сервис</h3>\n                    <div class=\"form-grid\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Ваше имя</label>\n                            <input type=\"text\" id=\"name\" required placeholder=\"Иван\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Телефон</label>\n                            <input type=\"tel\" id=\"phone\" required placeholder=\"+7 (___) ___-__-__\">\n                        </div>\n                        <div class=\"form-group full\">\n                            <label for=\"auto\">Марка и модель авто</label>\n                            <input type=\"text\" id=\"auto\" required placeholder=\"Например, Kia Rio\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Услуга</label>\n                            <select id=\"service\" required>\n                                <option value=\"\" disabled selected>Выберите услугу</option>\n                                <option value=\"ТО\">Слесарные работы / ТО</option>\n                                <option value=\"Малярка\">Малярные работы</option>\n                                <option value=\"Кузовной\">Кузовной ремонт</option>\n                                <option value=\"Диагностика\">Диагностика</option>\n                                <option value=\"Детейлинг\">Полировка / Детейлинг</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"date\">Желаемая дата и время</label>\n                            <input type=\"datetime-local\" id=\"date\" required>\n                        </div>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-full\">Отправить заявку</button>\n                </form>\n                \n                <div id=\"formSuccess\" class=\"form-success\">\n                    <h4>Заявка отправлена!</h4>\n                    <p>Спасибо за доверие. Наш мастер-приемщик свяжется с вами в течение 10 минут для подтверждения записи.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <footer>\n        <div class=\"container\">\n            <p>&copy; 2024 Автосервис «МоторХаус». Все права защищены.</p>\n        </div>\n    </footer>\n\n    <!-- Mobile Sticky CTA -->\n    <a href=\"#booking\" id=\"mobileCta\" class=\"mobile-cta\">Записаться онлайн</a>\n\n    <script>\n        // Hamburger Menu\n        const hamburger = document.getElementById('hamburger');\n        const navLinks = document.getElementById('navLinks');\n        const navItems = document.querySelectorAll('.nav-item');\n\n        hamburger.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n            hamburger.textContent = navLinks.classList.contains('active') ? '✕' : '☰';\n        });\n\n        navItems.forEach(item => {\n            item.addEventListener('click', () => {\n                if (window.innerWidth <= 768) {\n                    navLinks.classList.remove('active');\n                    hamburger.textContent = '☰';\n                }\n            });\n        });\n\n        // FAQ Accordion\n        const faqQuestions = document.querySelectorAll('.faq-question');\n        faqQuestions.forEach(question => {\n            question.addEventListener('click', () => {\n                const item = question.parentElement;\n                // Close others\n                document.querySelectorAll('.faq-item').forEach(faq => {\n                    if (faq !== item) faq.classList.remove('active');\n                });\n                item.classList.toggle('active');\n            });\n        });\n\n        // Form Submission\n        const form = document.getElementById('bookingForm');\n        const formSuccess = document.getElementById('formSuccess');\n\n        form.addEventListener('submit', (e) => {\n            e.preventDefault();\n            form.style.display = 'none';\n            formSuccess.style.display = 'block';\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.observe-animate').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Hide Mobile CTA when reaching the booking section\n        const mobileCta = document.getElementById('mobileCta');\n        const bookingSection = document.getElementById('booking');\n\n        const ctaObserver = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    mobileCta.classList.add('hidden');\n                } else {\n                    mobileCta.classList.remove('hidden');\n                }\n            });\n        }, { threshold: 0.1 });\n\n        ctaObserver.observe(bookingSection);\n    </script>\n<a class=\"zeus-badge\" href=\"https://zeuscode.ru\" target=\"_blank\" rel=\"noopener noreferrer\">Сделано на ZeusCode</a>\n<style id=\"zeus-badge-css\">\n.zeus-badge{\n  position:fixed;right:14px;bottom:12px;z-index:2147483646;\n  font:500 11px/1.25 system-ui,-apple-system,Segoe UI,sans-serif;\n  letter-spacing:.02em;text-decoration:none;\n  color:rgba(120,120,120,.42);pointer-events:auto;\n  transition:color .2s ease,opacity .2s ease;\n}\n.zeus-badge:hover{color:rgba(120,120,120,.78)}\n</style>\n</body>\n</html>\n\n---\n🔗 Живая ссылка: https://zeuscode.ru/go/site-1ff5/\n",
